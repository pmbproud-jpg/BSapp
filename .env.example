# =====================================================================
# BSapp — przykładowy plik konfiguracyjny środowiska
# =====================================================================
# Skopiuj ten plik do `.env` (który jest gitignored) i uzupełnij wartości.
# Po rotacji kluczy NIGDY nie commituj `.env` do repozytorium.
#
# Instrukcja rotacji i pełna procedura: docs/SECURITY.md
# =====================================================================

# --- Frontend (expo bundle) -------------------------------------------
# Te zmienne mają prefiks EXPO_PUBLIC_* i trafiają do bundla klienta.
# Mogą być jawne — Supabase anon key jest publiczny z założenia,
# bezpieczeństwo opiera się na RLS i proxy (netlify/functions/supabase-admin.js).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_SITE_URL=https://bsapp-management.netlify.app

# --- Netlify Functions (server-side only) -----------------------------
# UWAGA: te klucze NIE mają prefiksu EXPO_PUBLIC_ — nie mogą trafić do
# bundla frontendowego. Produkcyjnie trzymaj je wyłącznie w:
#   Netlify Dashboard → Site settings → Environment variables
# Lokalnie są potrzebne tylko przy `netlify dev` dla funkcji serverless.
#
# SUPABASE_SERVICE_ROLE_KEY omija RLS — traktuj jak hasło root do bazy.
# Jeżeli wyciekł, zrotuj natychmiast (Supabase Dashboard → API → Rotate).
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Opcjonalne -------------------------------------------------------
# ALLOWED_ORIGIN=https://bsapp-management.netlify.app
